{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "speclane",
  "version": "0.5.0",
  "description": "面向 Codex 的可恢复、规范驱动开发工作流。",
  "author": {
    "name": "fool1582"
  },
  "repository": "https://gitee.com/fool1582/SpecLane",
  "license": "MIT",
  "keywords": [
    "codex",
    "openspec",
    "workflow",
    "figma",
